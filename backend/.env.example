# Tavily API configuration for Web Search Agent (Milestone 1)
# Get your API key from https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_key_here

# (Optional) LLM API Configurations for Market & Competitor Agents (Milestone 2)
# The system supports Google Gemini (Free tier available), Groq, or OpenAI
# If unconfigured, the system automatically uses smart domain synthesis fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
